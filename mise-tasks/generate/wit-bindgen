#!/usr/bin/env bash
#MISE description="Regenerate MoonBit WIT bindings from wit/ definitions"
set -euo pipefail

wit-bindgen moonbit wit/ \
  --out-dir src/ \
  --gen-dir component \
  --project-name moonrockz/gherkin \
  --ignore-module-file \
  --ignore-stub \
  --derive-show \
  --derive-eq

# wit-bindgen still writes deprecated moon.pkg.json files. This project keeps
# its package configuration in moon.pkg; leaving both triggers MoonBit warnings.
rm -f \
  src/component/moon.pkg.json \
  src/interface/moonrockz/gherkin/types/moon.pkg.json \
  src/world/gherkin/moon.pkg.json
