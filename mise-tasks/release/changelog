#!/usr/bin/env bash
#MISE description="Generate CHANGELOG.md from conventional commits"
set -euo pipefail

# Use version from moon.mod as the tag (allows manual version override).
VERSION=$(sed -nE 's/^version = "([^"]*)".*/\1/p' moon.mod | head -n 1)
git cliff --tag "v${VERSION}" -o CHANGELOG.md
echo "CHANGELOG.md updated (v${VERSION})."
