  "moonrockz/gherkin/component/interface/moonrockz/gherkin/writer",
  "moonrockz/gherkin/interface/moonrockz/gherkin/types",
}

warnings = "-44"

options(
  link: {
    "wasm": {
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportParse:moonrockz:gherkin/parser@0.2.0#parse",
        "wasmExportParsePostReturn:cabi_post_moonrockz:gherkin/parser@0.2.0#parse",
        "wasmExportTokenize:moonrockz:gherkin/tokenizer@0.2.0#tokenize",
        "wasmExportTokenizePostReturn:cabi_post_moonrockz:gherkin/tokenizer@0.2.0#tokenize",
        "wasmExportWrite:moonrockz:gherkin/writer@0.2.0#write",
        "wasmExportWriteEvents:moonrockz:gherkin/writer@0.2.0#write-events",
        "wasmExportWriteEventsPostReturn:cabi_post_moonrockz:gherkin/writer@0.2.0#write-events",
        "wasmExportWritePostReturn:cabi_post_moonrockz:gherkin/writer@0.2.0#write",
      ],
      "export-memory-name": "memory",
    },
  },
)
